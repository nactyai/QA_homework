  "tests": [{
    "id": "c13ed0d2-56c9-4561-b5e9-b2539bb7a37d",
    "name": "TEST CASE 1: Product Search Verification",
    "commands": [{
      "id": "4f38ce7d-f218-4fea-80c5-547d7206435e",
      "comment": "",
      "command": "open",
      "target": "https://rozetka.com.ua",
      "targets": [],
      "value": ""
    }, {
      "id": "52d2e148-5fa3-4f2a-9966-d832cd6e19bd",
      "comment": "",
      "command": "store",
      "target": "iPhone 13",
      "targets": [],
      "value": "searchQuery"
    }, {
      "id": "edcb6616-4099-4b31-994c-e61cd4938270",
      "comment": "",
      "command": "waitForElementVisible",
      "target": "css=input[name=\"search\"]",
      "targets": [],
      "value": "10000"
    }, {
      "id": "139dc66f-aa95-475c-936f-71e98cc82365",
      "comment": "",
      "command": "type",
      "target": "css=input[name=\"search\"]",
      "targets": [],
      "value": "${searchQuery}"
    }, {
      "id": "6d0205bb-4782-408e-9a0e-d8471a804fdc",
      "comment": "",
      "command": "click",
      "target": "xpath=//button[contains(text(), 'Знайти')]",
      "targets": [],
      "value": ""
    }, {
      "id": "4d98fc57-6782-4a29-8861-f511dd017423",
      "comment": "",
      "command": "sendKeys",
      "target": "css=input[name=\"search\"]",
      "targets": [],
      "value": "${KEY_ENTER}"
    }, {
      "id": "b91e7a3e-f8b4-496d-9688-809bedf7e1f6",
      "comment": "",
      "command": "waitForElementVisible",
      "target": "xpath=//h1",
      "targets": [],
      "value": "20000"
    }, {
      "id": "54b7f0d5-092e-4860-9cea-ae1f84513c0a",
      "comment": "",
      "command": "assertText",
      "target": "xpath=//h1",
      "targets": [],
      "value": "${searchQuery}"
    }, {
      "id": "c8e05831-1a1b-43fb-8e5a-2c4f01154cfc",
      "comment": "",
      "command": "waitForElementPresent",
      "target": "xpath=(//a[contains(text(), '${searchQuery}')])[1]",
      "targets": [],
      "value": "15000"
    }, {
      "id": "6534cab4-0e8c-4fb2-bd63-f4327f8e395e",
      "comment": "",
      "command": "storeText",
      "target": "xpath=(//a[contains(text(), '${searchQuery}')])[1]",
      "targets": [],
      "value": "foundProduct"
    }, {
      "id": "7d436951-6628-4612-873e-abce058bcff7",
      "comment": "",
      "command": "echo",
      "target": "Product Found: ${foundProduct}",
      "targets": [],
      "value": ""
    }]
